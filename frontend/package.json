{
  "name": "puntostock-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "pwsh -NoProfile -File ../scripts/Start-Frontend.ps1",
    "start:local": "pwsh -NoProfile -File ../scripts/Start-Frontend.ps1",
    "build": "ng build",
    "test": "vitest run",
    "lint": "eslint src && tsc --noEmit -p tsconfig.json",
    "format": "prettier --write src tests *.mts *.mjs *.json",
    "format:check": "prettier --check src tests *.mts *.mjs *.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/material": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "8.3.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
